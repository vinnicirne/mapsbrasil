{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:endpoint(config|me|join|accept)",
      "destination": "/api/bridge?endpoint=:endpoint"
    },
    {
      "source": "/api/companies/:company/:action",
      "destination": "/api/bridge?endpoint=companies/:company/:action"
    },
    {
      "source": "/api/empresa/:domain/:action",
      "destination": "/api/bridge?endpoint=empresa/:domain/:action"
    },
    {
      "source": "/gestao",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/bridge.mjs": {
      "maxDuration": 40,
      "includeFiles": "{public/packs/rio-do-ouro.json,server/packs/rio-do-ouro-faccoes.json}"
    }
  }
}
